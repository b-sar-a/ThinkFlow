# Gemini
GEMINI_API_KEY=
# Optional: override the model
# GEMINI_MODEL=gemini-3-flash-preview

# Firebase Admin (server-side quota + promo codes).
# Paste the full service-account JSON on ONE line (or base64 of it).
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_PROJECT_ID=gen-lang-client-0029250191
# FIRESTORE_DATABASE_ID=ai-studio-40c22e6e-5fc3-462c-ad48-ab8924415ba7

# Optional: comma-separated origins allowed to call /api cross-origin (leave empty for same-origin only)
# ALLOWED_ORIGINS=https://your-domain.com

# Optional: promo codes as JSON {"CODE": tokens}. Defaults are used if empty.
# PROMO_CODES={"FREEGENIUS":10000,"STARTAI":5000,"LEARNFLOW":8000}
